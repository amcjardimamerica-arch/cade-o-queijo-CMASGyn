__pycache__/
*.pyc
.env

# PDFs NUNCA entram no repositório. A prova é o par (SHA-256, URL oficial),
# gravado em estado/historico_registro.json. O arquivo assinado permanece
# obtenível na origem e sua integridade é aferível pelo digest.
acervo/historico/pdf/
acervo/dom/
*.pdf
*.ocr.pdf

# Texto integral comprimido: fica local para o banco de busca, fora do repositório.
# Quem clona reconstrói com `python cadeoqueijo/historico.py`.
acervo/historico/txt/
acervo/historico/txt_gz/
dados/cmasgyn.db*

corpus/brutos/*.html
estado/http_cache.json
node_modules/
estado/fnas/*.xlsx

# Testes
.pytest_cache/
*.egg-info/

# Onisciente: o SQLite de trabalho da despesa é refeito dos .jsonl.gz (onisciente/partes.py).
dados/onisciente/despesa/*.sqlite
dados/onisciente/despesa/*.sqlite-journal
dados/onisciente/despesa/*.sqlite.tmp
dados/onisciente/despesa/*.tmp
